<.header>
  Listing Users
  <:actions>
    <.link href={~p"/users/new"}>
      <.button>New User</.button>
    </.link>
  </:actions>
</.header>

<.table id="users" rows={@users}>
  <:col :let={user} label="Email">{user.email}</:col>
  <:col :let={user} label="Company">{user.company_id}</:col>
  <:col :let={user} label="Role">{user.role}</:col>
  <:action :let={user}>
    <.link href={~p"/users/#{user}"}>Show</.link>
  </:action>
  <:action :let={user}>
    <.link href={~p"/users/#{user}/edit"}>Edit</.link>
  </:action>
  <:action :let={user}>
    <.link href={~p"/users/#{user}"} method="delete" data-confirm="Are you sure?">
      Delete
    </.link>
  </:action>
</.table>
