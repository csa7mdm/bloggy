<.header>
  Listing Posts
  <:actions>
    <.link href={~p"/posts/new"}>
      <.button>New Post</.button>
    </.link>
  </:actions>
</.header>

<.table id="posts" rows={@posts}>
  <:col :let={post} label="Title">{post.title}</:col>
  <:col :let={post} label="Body">{String.slice(post.body || "", 0, 100)}</:col>
  <:action :let={post}>
    <.link href={~p"/posts/#{post}"}>Show</.link>
  </:action>
  <:action :let={post}>
    <.link href={~p"/posts/#{post}/edit"}>Edit</.link>
  </:action>
  <:action :let={post}>
    <.link href={~p"/posts/#{post}"} method="delete" data-confirm="Are you sure?">
      Delete
    </.link>
  </:action>
</.table>
