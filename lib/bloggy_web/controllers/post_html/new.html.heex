<.header>
  New Post
</.header>

<.simple_form :let={f} for={@changeset} action={~p"/posts"}>
  <.error :if={@changeset.action}>
    Oops, something went wrong! Please check the errors below.
  </.error>

  <.input field={f[:title]} type="text" label="Title" />
  
  <div id="editor-wrapper" class="mt-2" phx-update="ignore">
    <.label for="post_body">Body</.label>
    <textarea id="post_body" name="post[body]" phx-hook="Editor" class="hidden">
      <%= Ecto.Changeset.get_field(@changeset, :body) %>
    </textarea>
  </div>

  <:actions>
    <.button>Save Post</.button>
  </:actions>
</.simple_form>

<.back navigate={~p"/posts"}>Back to posts</.back>
