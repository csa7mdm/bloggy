<header class="px-4 sm:px-6 lg:px-8">
  <div class="flex items-center justify-between border-b border-zinc-100 py-3 text-sm">
    <div class="flex items-center gap-4">
      <a href={~p"/"} class="group flex items-center gap-2">
        <img src={~p"/images/logo.svg"} width="36" class="transition-transform group-hover:scale-110" />
        <span class="font-bold text-lg text-zinc-900 group-hover:text-brand transition-colors">Bloggy</span>
      </a>
      <div class="hidden sm:flex items-center gap-4 pl-4 border-l border-zinc-200">
        <.link href={~p"/posts"} class="text-zinc-600 hover:text-zinc-900 font-medium pb-0.5 border-b-2 border-transparent hover:border-brand transition-all">
          Explore
        </.link>
        <a href="#" class="text-zinc-500 hover:text-zinc-900 font-medium transition-colors">About</a>
      </div>
    </div>
    <div class="flex items-center gap-4 font-semibold leading-6 text-zinc-900">
      <%= if @current_user do %>
        <span class="hidden sm:inline text-zinc-500 font-normal">Hello, {@current_user.email}</span>
        <.link href={~p"/posts/new"} class="bg-zinc-900 text-white hover:bg-zinc-700 px-3 py-2 rounded-lg text-xs sm:text-sm transition-colors">
          Write
        </.link>
        <.link href={~p"/sessions/#{@current_user.id}"} method="delete" class="text-zinc-600 hover:text-zinc-900 transition-colors">
          Log out
        </.link>
      <% else %>
        <a href={~p"/users/new"} class="text-zinc-600 hover:text-zinc-900 transition-colors">
          Register
        </a>
        <a href={~p"/sessions/new"} class="bg-brand text-white hover:bg-brand/90 px-4 py-2 rounded-lg transition-all shadow-sm hover:shadow-md">
          Sign In
        </a>
      <% end %>
    </div>
  </div>
</header>
<main class="px-4 py-10 sm:px-6 lg:px-8">
  <div class="mx-auto max-w-5xl">
    <.flash_group flash={@flash} />
    {@inner_content}
  </div>
</main>
<footer class="mt-20 border-t border-zinc-100 py-10">
  <div class="mx-auto max-w-5xl px-4 flex justify-between items-center text-sm text-zinc-500">
    <p>&copy; 2026 Bloggy Inc. AI-Native Publishing.</p>
    <div class="flex gap-4">
      <a href="#" class="hover:text-zinc-900">Privacy</a>
      <a href="#" class="hover:text-zinc-900">Terms</a>
      <a href="#" class="hover:text-zinc-900">RSS</a>
    </div>
  </div>
</footer>
